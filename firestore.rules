rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hgntran.contact@gmail.com';
    }

    // ── Collection: users ───────────────────────────────────────────────────
    match /users/{userId} {

      // Đọc: chỉ doc của chính mình hoặc admin
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Tạo mới: chỉ plan='free', không có field admin-only
      // (admin bypass toàn bộ — admin.html dùng setDoc để doReadd/restore)
      allow create: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.plan == 'free'
        && request.resource.data.status in ['approved', 'pending']
        && request.resource.data.email == request.auth.token.email
        && !('kickReason'  in request.resource.data)
        && !('readdedAt'   in request.resource.data)
        && !('readdNote'   in request.resource.data)
        && !('approvedAt'  in request.resource.data)
        && !('upgradedAt'  in request.resource.data)
      );

      // Cập nhật: không được thay đổi plan / approved / status / email
      // User chỉ được cập nhật: freeUsedMB, freeResetAt, upgradeRequestedAt,
      //                          displayName, photoURL (profile sync)
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.plan     == resource.data.plan
        && request.resource.data.approved == resource.data.approved
        && request.resource.data.status   == resource.data.status
        && request.resource.data.email    == resource.data.email
        && !('kickReason'  in request.resource.data)
        && !('readdedAt'   in request.resource.data)
        && !('readdNote'   in request.resource.data)
        && !('approvedAt'  in request.resource.data)
        && !('upgradedAt'  in request.resource.data)
      );

      // Xóa: chỉ admin
      allow delete: if isAdmin();
    }

    // ── Collection: history ─────────────────────────────────────────────────
    match /history/{docId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // ── Collection: settings ────────────────────────────────────────────────
    // Chỉ admin (admin-maintenance.html) được đọc/ghi trực tiếp.
    // api/maintenance.js đọc qua service account → bypass Rules hoàn toàn.
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Collection: affiliates ──────────────────────────────────────────────
    // Admin: đọc/ghi toàn bộ. CTV: chỉ đọc doc của chính mình.
    // User thường không có quyền truy cập.
    match /affiliates/{code} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null
        && resource.data.email == request.auth.token.email;
      // CTV tự tạo đơn đăng ký mới (status phải là pending, email khớp auth)
      allow create: if request.auth != null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
      // CTV cập nhật thông tin ngân hàng + urgentRequest — không được đổi các field tài chính
      allow update: if request.auth != null
        && resource.data.email == request.auth.token.email
        && request.resource.data.email           == resource.data.email
        && request.resource.data.status          == resource.data.status
        && request.resource.data.code            == resource.data.code
        && request.resource.data.commissionRate  == resource.data.commissionRate
        && request.resource.data.totalEarned     == resource.data.totalEarned
        && request.resource.data.totalPaid       == resource.data.totalPaid
        && request.resource.data.totalClients    == resource.data.totalClients
        && request.resource.data.totalConverted  == resource.data.totalConverted;
    }

    // Subcollection commissions — CTV chỉ đọc HH của mình (kiểm tra qua doc cha)
    match /affiliates/{code}/commissions/{commId} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/affiliates/$(code)).data.email
           == request.auth.token.email;
    }
  }
}

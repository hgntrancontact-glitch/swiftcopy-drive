{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/copy-drive", "destination": "/dashboard.html" },
    { "source": "/dieu-khoan", "destination": "/legal.html"  },
    { "source": "/bao-mat",    "destination": "/legal.html"  },
    { "source": "/hoan-tien",  "destination": "/legal.html"  }
  ]
}
